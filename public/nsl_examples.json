    {
      "name": "walk_scl",
      "description": "This example uses the Scale value type to retrieve pitches based on the active scale / key.",
      "commands": [
        {
          "cmd": "Set",
          "x": {
            "type": "MemoryBuffer",
            "dv": { "kind": "number", "value": 0 }
          },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 0 } }
        },
        {
          "cmd": "Set",
          "x": {
            "type": "MemoryBuffer",
            "dv": { "kind": "number", "value": 1 }
          },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 0 } }
        },
        {
          "cmd": "LoopSet",
          "x": { "type": "Constant", "dv": { "kind": "number", "value": 8 } }
        },
        {
          "cmd": "Set",
          "x": { "type": "StepPitch", "dv": { "kind": "buffer", "value": 0 } },
          "y": { "type": "Scale", "dv": { "kind": "buffer", "value": 1 } }
        },
        {
          "cmd": "Add",
          "x": { "type": "StepPitch", "dv": { "kind": "buffer", "value": 0 } },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 48 } }
        },
        {
          "cmd": "Set",
          "x": {
            "type": "StepVelocity",
            "dv": { "kind": "buffer", "value": 0 }
          },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 100 } }
        },
        {
          "cmd": "Set",
          "x": { "type": "StepLength", "dv": { "kind": "buffer", "value": 0 } },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 1 } }
        },
        {
          "cmd": "Set",
          "x": {
            "type": "StepDensity",
            "dv": { "kind": "buffer", "value": 0 }
          },
          "y": { "type": "Random", "dv": { "kind": "number", "value": 48 } }
        },
        {
          "cmd": "Add",
          "x": {
            "type": "MemoryBuffer",
            "dv": { "kind": "number", "value": 1 }
          },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 1 } }
        },
        {
          "cmd": "Add",
          "x": {
            "type": "MemoryBuffer",
            "dv": { "kind": "number", "value": 0 }
          },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 1 } }
        },
        { "cmd": "LoopEnd" },
        { "cmd": "End" }
      ]
    },
    {
      "name": "euclid",
      "description": "Generates a rising sequence based on an euclidean sequence. In this example, we only set up the notes generates by the euclidean sequencer (velocity > 0).",
      "commands": [
        {
          "cmd": "GenerateEuclidean",
          "x": { "type": "Random", "dv": { "kind": "number", "value": 32 } },
          "y": { "type": "Random", "dv": { "kind": "number", "value": 8 } }
        },
        {
          "cmd": "Set",
          "x": {
            "type": "MemoryBuffer",
            "dv": { "kind": "number", "value": 0 }
          },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 0 } }
        },
        {
          "cmd": "LoopSet",
          "x": { "type": "Constant", "dv": { "kind": "number", "value": 32 } }
        },
        {
          "cmd": "CondGT",
          "x": {
            "type": "StepVelocity",
            "dv": { "kind": "buffer", "value": 0 }
          },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 0 } }
        },
        {
          "cmd": "Set",
          "x": { "type": "StepPitch", "dv": { "kind": "buffer", "value": 0 } },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 60 } }
        },
        {
          "cmd": "Add",
          "x": { "type": "StepPitch", "dv": { "kind": "buffer", "value": 0 } },
          "y": { "type": "Constant", "dv": { "kind": "buffer", "value": 0 } }
        },
        {
          "cmd": "Set",
          "x": { "type": "StepLength", "dv": { "kind": "buffer", "value": 0 } },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 1 } }
        },
        {
          "cmd": "Set",
          "x": {
            "type": "StepDensity",
            "dv": { "kind": "buffer", "value": 0 }
          },
          "y": { "type": "Random", "dv": { "kind": "number", "value": 48 } }
        },
        { "cmd": "CondEnd" },
        {
          "cmd": "Add",
          "x": {
            "type": "MemoryBuffer",
            "dv": { "kind": "number", "value": 0 }
          },
          "y": { "type": "Constant", "dv": { "kind": "number", "value": 1 } }
        },
        { "cmd": "LoopEnd" },
        { "cmd": "End" }
      ]
    }
  ]
}
